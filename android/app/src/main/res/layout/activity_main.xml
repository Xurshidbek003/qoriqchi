<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fon"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👁  Ekran qo\'riqchisi"
            android:textColor="@color/matn"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Bolalar ko\'zini ekrandan himoya qiladi"
            android:textColor="@color/kulrang"
            android:textSize="14sp" />

        <!-- Ruxsatlar kartasi -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/ruxsatKarta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="#FFF7ED"
            app:cardCornerRadius="16dp"
            app:strokeColor="#FDBA74"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/ruxsatMatn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/matn"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ruxsatTugma"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Ruxsat berish" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Holat kartasi -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#E5E7EB"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/Yorliq"
                    android:text="Holat" />

                <TextView
                    android:id="@+id/holatMatn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Himoya o\'chiq"
                    android:textColor="@color/kulrang"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Yorliq"
                    android:layout_marginTop="14dp"
                    android:text="Ekrangacha masofa" />

                <TextView
                    android:id="@+id/masofaMatn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/matn"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Yorliq"
                    android:layout_marginTop="14dp"
                    android:text="Uzluksiz qarash" />

                <TextView
                    android:id="@+id/tomoshaMatn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00 / 20:00"
                    android:textColor="@color/matn"
                    android:textSize="18sp" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/tomoshaBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:max="100"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="8dp" />

                <TextView
                    android:id="@+id/statMatn"
                    style="@style/Yorliq"
                    android:layout_marginTop="14dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/izohMatn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/sariq"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/yoqishTugma"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:text="Himoyani yoqish"
            android:textSize="17sp"
            app:cornerRadius="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/kalibrTugma"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="📏 Kalibrlash" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sozlamaTugma"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="⚙ Sozlamalar" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pauzaTugma"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="⏸ 15 daqiqa pauza" />
    </LinearLayout>
</ScrollView>
